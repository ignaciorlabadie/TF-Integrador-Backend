NODE_ENV=development
PORT=3000

# Conexión local (usado por Docker/local con Postgres)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=tfi_turnos
DB_USER=postgres
DB_PASSWORD=postgres

# Para producción (Render + Neon). En local debe quedar comentada:
# si tiene valor, se usa en lugar de DB_* y se intenta conectar a Neon.
# DATABASE_URL=postgresql://usuario:password@host/db?sslmode=require&channel_binding=require

JWT_SECRET=cambiar-esto
JWT_EXPIRES_IN=1d
BCRYPT_SALT_ROUNDS=10

# Recuperación de contraseña
FRONTEND_URL=http://localhost:5173
RESET_TOKEN_TTL_MINUTES=30

# Brevo (envío de emails por API HTTP). Opcional: sin estas variables
# no se envían emails (el fallo se registra en consola).
# BREVO_API_KEY=<tu-api-key-de-brevo>
# EMAIL_FROM=remitente-verificado@example.com
# EMAIL_FROM_NAME=Sistema de Turnos

# Recordatorios de turnos. Deshabilitados en local: requieren Brevo
# para enviar emails. Cambiar a true (con Brevo configurado) para probarlos.
APP_TIMEZONE=America/Argentina/Buenos_Aires
RECORDATORIOS_TURNOS_HABILITADOS=false
# RECORDATORIO_TURNO_INTERVALO_MS=600000

PGADMIN_DEFAULT_EMAIL=admin@local.com
PGADMIN_DEFAULT_PASSWORD=admin123

# Supabase Storage - Estudios Médicos. Opcional solo en development:
# sin ellas, subir estudios devuelve 503; fuera de development son obligatorias.
# SUPABASE_URL=https://<tu-project-ref>.supabase.co
# SUPABASE_SERVICE_ROLE_KEY=<tu-service-role-key>
# SUPABASE_BUCKET=estudios-medicos
# SUPABASE_SIGNED_URL_TTL=3600
