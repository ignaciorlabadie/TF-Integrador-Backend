NODE_ENV=development
PORT=3000

# Conexión local (usado por Docker/local con Postgres)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=tfi_turnos
DB_USER=postgres
DB_PASSWORD=postgres

# Para producción (Render + Neon). Si está definido, se usa en lugar de DB_*
DATABASE_URL=postgresql://usuario:password@host/db?sslmode=require&channel_binding=require

JWT_SECRET=cambiar-esto
JWT_EXPIRES_IN=1d
BCRYPT_SALT_ROUNDS=10

PGADMIN_DEFAULT_EMAIL=admin@local.com
PGADMIN_DEFAULT_PASSWORD=admin123

# Supabase Storage - Estudios Médicos
SUPABASE_URL=https://<tu-project-ref>.supabase.co
SUPABASE_SERVICE_ROLE_KEY=<tu-service-role-key>
SUPABASE_BUCKET=estudios-medicos
SUPABASE_SIGNED_URL_TTL=3600