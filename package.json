{
    "name": "tfi-backend",
    "version": "1.0.0",
    "description": "",
    "main": "dist/server.js",
    "scripts": {
        "test": "vitest run",
        "test:watch": "vitest",
        "dev": "tsx watch src/server.ts",
        "build": "tsc",
        "start": "node dist/server.js",
        "lint": "eslint .",
        "format": "prettier . --write",
        "format:check": "prettier . --check",
        "db:migration:generate": "sequelize-cli migration:generate --config src/config/config.js --migrations-path src/database/migrations",
        "db:migrate": "sequelize-cli db:migrate --config src/config/config.js --migrations-path src/database/migrations",
        "db:migrate:status": "sequelize-cli db:migrate:status --config src/config/config.js --migrations-path src/database/migrations",
        "db:migrate:undo": "sequelize-cli db:migrate:undo --config src/config/config.js --migrations-path src/database/migrations",
        "db:seed": "sequelize-cli db:seed --config src/config/config.js --seeders-path src/database/seeders",
        "db:seed:all": "sequelize-cli db:seed:all --config src/config/config.js --seeders-path src/database/seeders",
        "db:seed:undo": "sequelize-cli db:seed:undo --config src/config/config.js --seeders-path src/database/seeders",
        "db:seed:undo:all": "sequelize-cli db:seed:undo:all --config src/config/config.js --seeders-path src/database/seeders",
        "prepare": "husky"
    },
    "keywords": [],
    "author": "",
    "license": "ISC",
    "type": "module",
    "engines": {
        "node": "24.20.0"
    },
    "dependencies": {
        "@supabase/supabase-js": "^2.118.0",
        "bcryptjs": "3.0.3",
        "cors": "2.8.6",
        "dotenv": "18.0.3",
        "express": "5.2.1",
        "jsonwebtoken": "9.0.3",
        "multer": "^2.5.0",
        "pg": "8.23.0",
        "pg-hstore": "2.3.4",
        "sequelize": "6.37.8"
    },
    "devDependencies": {
        "@eslint/js": "10.0.1",
        "@types/bcryptjs": "2.4.6",
        "@types/cors": "2.8.19",
        "@types/express": "5.0.6",
        "@types/jsonwebtoken": "9.0.10",
        "@types/multer": "^2.3.0",
        "@types/node": "26.6.2",
        "@types/supertest": "7.2.1",
        "eslint": "10.11.0",
        "husky": "9.1.7",
        "prettier": "3.9.9",
        "sequelize-cli": "6.6.5",
        "supertest": "7.3.1",
        "tsx": "4.23.15",
        "typescript": "5.9.2",
        "typescript-eslint": "8.70.1",
        "vitest": "5.0.1"
    }
}
